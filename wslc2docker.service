[Unit]
Description=wslc2docker - Docker Engine API shim for WSLC
Documentation=https://github.com/your-org/wslc2docker
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/wslc2docker --socket /var/run/docker.sock --config /etc/wslc2docker/endpoints.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
User=root
# 创建 /var/run/docker.sock 需要写 /var/run；如需绑定 1024 以下端口再加 CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
